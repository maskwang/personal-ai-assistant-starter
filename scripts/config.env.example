# 复制为 scripts/config.env 后填写；此文件含凭据，已在 .gitignore 中排除。
# 建议权限：chmod 600 scripts/config.env

# 钉钉自定义机器人 Webhook（群设置 → 智能群助手 → 添加机器人 → 自定义）
DINGTALK_WEBHOOK="https://oapi.dingtalk.com/robot/send?access_token=REPLACE_ME"

# 机器人安全设置若选「自定义关键词」，消息必须包含该词，否则会被拒收（errcode 310000）
DINGTALK_KEYWORD="行动"

# 你的 vault 根目录（绝对路径，不要用 ~）
VAULT_ROOT="/ABSOLUTE/PATH/TO/my-assistant/vault"

# 自动提交用的 git 分支（留空则提交到当前分支）
GIT_BRANCH=""
